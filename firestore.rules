rules_version = '2';
// Tenaball: accounts, online game rooms and the move log each room is replayed from.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 20; }

    // Each account's profile and stats: only its owner can read or write them.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /rooms/{code} {
      allow read: if signedIn();

      // The host opens a room in the lobby with only themselves in it.
      allow create: if signedIn()
        && request.resource.data.host == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.seq == 0 && request.resource.data.game == 1
        && request.resource.data.players.keys().hasOnly([request.auth.uid])
        && validName(request.resource.data.players[request.auth.uid].name);

      allow update: if signedIn() && request.resource.data.host == resource.data.host && (
        // the host runs the room (settings, removing players, starting, finishing)
        (resource.data.host == request.auth.uid
          && request.resource.data.players.size() <= 4
          && ((request.resource.data.seq >= resource.data.seq && request.resource.data.seq <= resource.data.seq + 1)
              // play again: back to the lobby for a fresh game
              || (request.resource.data.status == 'lobby' && request.resource.data.seq == 0
                  && request.resource.data.game == resource.data.game + 1)))
        // anyone else can join or leave while it's still in the lobby, touching only their own entry
        || (resource.data.status == 'lobby' && request.resource.data.status == 'lobby'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'updatedAt'])
          && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.players.size() <= 4
          && (!(request.auth.uid in request.resource.data.players)
              || validName(request.resource.data.players[request.auth.uid].name)))
        // players in a running game move the log on by exactly one
        || (resource.data.status == 'playing'
          && request.auth.uid in resource.data.players
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seq', 'updatedAt'])
          && request.resource.data.seq == resource.data.seq + 1)
      );

      allow delete: if signedIn() && resource.data.host == request.auth.uid;

      // The move log. Every device replays it in order, so moves are append-only.
      match /actions/{id} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.seq is int && request.resource.data.game is int
          && id == string(request.resource.data.game) + '_' + string(request.resource.data.seq)
          && getAfter(/databases/$(database)/documents/rooms/$(code)).data.status == 'playing'
          && getAfter(/databases/$(database)/documents/rooms/$(code)).data.game == request.resource.data.game
          && getAfter(/databases/$(database)/documents/rooms/$(code)).data.seq == request.resource.data.seq
          && request.auth.uid in getAfter(/databases/$(database)/documents/rooms/$(code)).data.players
          && (request.resource.data.type in ['guess', 'pass', 'timeout']
              || getAfter(/databases/$(database)/documents/rooms/$(code)).data.host == request.auth.uid);
        allow update, delete: if false;
      }
    }
  }
}
